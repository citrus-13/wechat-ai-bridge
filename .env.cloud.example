DATA_DIR=/data
CLOUD_BIND_HOST=127.0.0.1
CLOUD_PORT=43111

# Must match the Mac .env values.
BRIDGE_SHARED_SECRET=
SYNC_KEY=

# The Mac launch agent creates this reverse SSH port while the Mac is online.
MAC_BRIDGE_URL=http://127.0.0.1:43110

# Mac-off fallback through the official Codex CLI and ChatGPT OAuth.
# The container exposes no model port; the OAuth token stays in /codex-auth.
CLOUD_MODEL_STYLE=codex
CLOUD_CODEX_BIN=codex
CLOUD_CODEX_HOME=/codex-auth
CLOUD_CODEX_TIMEOUT_MS=120000
CLOUD_CODEX_MAX_OUTPUT_CHARS=6000
CLOUD_CODEX_MODEL_LUNA=gpt-5.6-luna
CLOUD_CODEX_MODEL_TERRA=gpt-5.6-terra
CLOUD_CODEX_MODEL_SOL=gpt-5.6-sol
CLOUD_CODEX_REASONING_LUNA=low
CLOUD_CODEX_REASONING_TERRA=high
CLOUD_CODEX_REASONING_SOL=xhigh
CLOUD_ALLOW_REMOTE_CONTEXT=false

# Host-side Compose paths. Relative paths are resolved from deploy/.
AGENT_WECHAT_IMAGE=ghcr.io/thisnick/agent-wechat@sha256:31a4e351c191bcbfc75e5c10be51e207d22a3eedd97f3ff56ad579fcce717b24
AGENT_WECHAT_TOKEN_FILE_HOST=./secrets/agent-wechat-token
CLOUD_DATA_DIR_HOST=./cloud-data
CODEX_AUTH_DIR_HOST=./codex-auth

# Every reminder is interpreted and displayed in this timezone.
REMINDER_TIMEZONE=Europe/Paris

# Ordinary personal WeChat group through agent-wechat. The API is loopback-only.
WECHAT_MODE=agent-wechat
AGENT_WECHAT_URL=http://127.0.0.1:6174
AGENT_WECHAT_TOKEN_FILE=/run/secrets/agent-wechat-token
WECHAT_TARGET_GROUP=
WECHAT_TARGET_CHAT_ID=
WECHAT_AI_NAME=AI
# Optional exact display-name allowlist. Leave empty for all contacts/members.
WECHAT_ALLOWED_SENDERS=
# Direct contacts auto-reply. Official accounts and built-in service sessions are excluded.
WECHAT_DM_POLICY=open
# Group default is native-mention-only. Exact immutable chat IDs override it.
WECHAT_GROUP_DEFAULT_MODE=mention-only
WECHAT_GROUP_ALL_REPLY_CHAT_IDS=
WECHAT_GROUP_MENTION_ONLY_CHAT_IDS=
WECHAT_GROUP_DISABLED_CHAT_IDS=
WECHAT_CHAT_PAGE_SIZE=100
WECHAT_MAX_CHATS=500
WECHAT_POLL_INTERVAL_MS=1500
WECHAT_POLL_PAGE_SIZE=200
WECHAT_BACKFILL_PAGE_SIZE=500
WECHAT_CONTEXT_MESSAGES=80
WECHAT_CONTEXT_CHARS=24000
WECHAT_MAX_REPLIES_PER_MINUTE=4
WECHAT_SENDER_COOLDOWN_SECONDS=8
WECHAT_MAX_MESSAGE_CHARS=4000
WECHAT_PAUSE_FILE=/data/PAUSE
